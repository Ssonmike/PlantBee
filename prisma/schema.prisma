// PlantBee - Prisma Schema
// Datasource: SQLite for development, switch to PostgreSQL for production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// AUTH MODELS (Auth.js / NextAuth v5)
// ─────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────
// CORE USER MODELS
// ─────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String? // null for OAuth users
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts        Account[]
  sessions        Session[]
  locationProfile LocationProfile?
  gardens         Garden[]
  userPlants      UserPlant[]
  reminders       Reminder[]
  plantScans      PlantScan[]
}

// User's geolocation profile for personalized care recommendations
model LocationProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  latitude    Float?
  longitude   Float?
  city        String?
  country     String?
  countryCode String?
  timezone    String?
  climateZone String? // tropical, subtropical, temperate, continental, polar, arid
  elevation   Float? // meters above sea level
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// GARDEN & PLANT MODELS
// ─────────────────────────────────────────

// Represents a user's garden (collection of plants)
model Garden {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  type        String   @default("mixed") // indoor, outdoor, balcony, mixed
  emoji       String   @default("🌿")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userPlants UserPlant[]
}

// Species catalog - shared across all users
// Pre-seeded with common plants, grows via scans
model Plant {
  id            String   @id @default(cuid())
  scientificName String  @unique
  commonName    String
  family        String?
  description   String?
  careLevel     String   @default("medium") // easy, medium, hard
  nativeRegion  String?
  imageUrl      String?
  wikiUrl       String?
  createdAt     DateTime @default(now())

  careRequirements PlantCareRequirements?
  userPlants       UserPlant[]
}

// Default care requirements per species
model PlantCareRequirements {
  id                   String  @id @default(cuid())
  plantId              String  @unique
  waterFrequencyDays   Int     @default(7) // base days between watering
  sunlight             String  @default("medium") // low, medium, high, direct
  humidity             String  @default("medium") // low, medium, high
  tempMin              Float?  // minimum temperature in Celsius
  tempMax              Float?  // maximum temperature in Celsius
  fertilizeFreqDays    Int?    @default(30)
  soilType             String? // well-draining, moist, sandy, loamy
  notes                String?

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)
}

// A specific plant instance owned by a user
model UserPlant {
  id            String    @id @default(cuid())
  userId        String
  gardenId      String?
  plantId       String? // null if custom/unidentified plant
  customName    String // user-given nickname
  photoUrl      String?
  acquiredDate  DateTime?
  notes         String?
  locationInHome String? // window, balcony, shelf, etc.
  healthStatus  String   @default("good") // good, warning, critical
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  garden        Garden?        @relation(fields: [gardenId], references: [id])
  plant         Plant?         @relation(fields: [plantId], references: [id])
  plantScans    PlantScan[]
  diagnoses     Diagnosis[]
  careSchedules CareSchedule[]
  reminders     Reminder[]
}

// ─────────────────────────────────────────
// SCANNING & DIAGNOSIS
// ─────────────────────────────────────────

// A photo scan submitted by the user
model PlantScan {
  id              String   @id @default(cuid())
  userId          String
  userPlantId     String? // null if standalone scan (before adding to garden)
  imageUrl        String
  scanType        String   @default("identify") // identify, diagnose
  rawResponse     String? // JSON string from Claude API
  identifiedPlantId String?
  confidenceScore Float?   // 0-1
  createdAt       DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userPlant UserPlant? @relation(fields: [userPlantId], references: [id])
  diagnosis Diagnosis?
}

// Diagnosis result from a scan
model Diagnosis {
  id          String   @id @default(cuid())
  plantScanId String   @unique
  userPlantId String?
  issues      String   @default("[]") // JSON: [{type, severity, description}]
  severity    String   @default("low") // low, medium, high
  recommendations String @default("[]") // JSON: [{step, description, priority}]
  isResolved  Boolean  @default(false)
  resolvedAt  DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plantScan PlantScan  @relation(fields: [plantScanId], references: [id], onDelete: Cascade)
  userPlant UserPlant? @relation(fields: [userPlantId], references: [id])
}

// ─────────────────────────────────────────
// CARE SCHEDULING
// ─────────────────────────────────────────

// Recurring care schedule for a specific plant
model CareSchedule {
  id                    String    @id @default(cuid())
  userPlantId           String
  careType              String    // water, fertilize, repot, prune, mist, rotate
  frequencyDays         Int       // base frequency in days
  adjustedFrequencyDays Int? // location-adjusted frequency
  lastDoneAt            DateTime?
  nextDueAt             DateTime
  adjustedForLocation   Boolean   @default(false)
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userPlant UserPlant  @relation(fields: [userPlantId], references: [id], onDelete: Cascade)
  reminders Reminder[]
}

// Individual care task instances (upcoming + past)
model Reminder {
  id             String    @id @default(cuid())
  userId         String
  userPlantId    String
  careScheduleId String?
  careType       String    // water, fertilize, repot, prune, mist, rotate
  dueDate        DateTime
  isDone         Boolean   @default(false)
  doneAt         DateTime?
  isSnoozed      Boolean   @default(false)
  snoozeUntil    DateTime?
  notes          String?
  createdAt      DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userPlant    UserPlant     @relation(fields: [userPlantId], references: [id], onDelete: Cascade)
  careSchedule CareSchedule? @relation(fields: [careScheduleId], references: [id])
}
